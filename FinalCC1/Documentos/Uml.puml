		+getZona() : String
		+setZona(String zona) : void
		+getPlaca() : String
		+toString() : String
	}
}

package "autorescate.model.funciones" {
	class ArregloDinamico<T> {
		-elementos : Object[]
		-tamano : int
		{static} -CAPACIDAD_INICIAL : int
		+ArregloDinamico()
		+agregar(T elemento) : void
		+obtener(int indice) : T
		+eliminar(int indice) : void
		+eliminarElemento(T elemento) : boolean
		+tamano() : int
		+estaVacio() : boolean
		-verificarIndice(int indice) : void
		-redimensionar() : void
	}

	class Cola<T> {
		-elementos : Object[]
		-frente : int
		-fondo : int
		-tamano : int
		{static} -CAPACIDAD_INICIAL : int
		+Cola()
		+encolar(T elemento) : void
		+desencolar() : T
		+verFrente() : T
		+obtener(int indice) : T
		+eliminarElemento(T elemento) : boolean
		+estaVacia() : boolean
		+tamano() : int
		-redimensionar() : void
	}

	class ColaPrioridad<T> {
		-elementos : Object[]
		-tamano : int
		{static} -CAPACIDAD_INICIAL : int
		+ColaPrioridad()
		+insertar(T elemento) : void
		+extraerMaximo() : T
		+verMaximo() : T
		+obtener(int indice) : T
		+eliminarElemento(T elemento) : boolean
		+estaVacia() : boolean
		+tamano() : int
		-redimensionar() : void
	}

	class Pila<T> {
		-elementos : Object[]
		-tope : int
		{static} -CAPACIDAD_INICIAL : int
		+Pila()
		+Pila(int capacidad)
		+apilar(T elemento) : void
		+desapilar() : T
		+verTope() : T
		+obtenerDesdeTope(int indiceDesdeTope) : T
		+estaVacia() : boolean
		+tamano() : int
		-redimensionar() : void
	}
}

package "autorescate.model.programa" {
	enum EstadoKit {
		DISPONIBLE
		EN_USO
		EN_REVISION
	}

	enum EstadoSolicitud {
		PENDIENTE
		EN_EJECUCION
		CERRADA
		CANCELADA
	}

	enum EstadoTecnico {
		DISPONIBLE
		OCUPADO
		INACTIVO
	}

	enum EstadoUnidad {
		DISPONIBLE
		ASIGNADA
		MANTENIMIENTO
		FUERA_DE_SERVICIO
	}

	enum TipoCliente {
		PARTICULAR
		EMPRESA_TRANSPORTE
		ASEGURADORA
	}

	enum TipoIncidente {
		VARADO
		PINCHADO
		CHOQUE
		BATERIA
		SIN_COMBUSTIBLE
		LLAVES_DENTRO
		FALLA_MECANICA
		FALLA_ELECTRICA
		GRUA_URGENTE
		VEHICULO_BLOQUEA_VIA
		PERSONAS_EN_RIESGO
		OTRO

		-descripcion : String
		-prioridadSugerida : int
		+getDescripcion() : String
		+getPrioridadSugerida() : int
		+toString() : String
	}

	enum TipoServicio {
		GRUA
		MOTO_APOYO
		CAMIONETA_ASISTENCIA
		VEHICULO_LIVIANO
	}

	enum TipoUnidad {
		GRUA
		MOTO_APOYO
		CAMIONETA
		VEHICULO_LIVIANO
	}
}

