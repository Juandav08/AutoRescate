		-prioridad : int
		-descripcion : String
		-ubicacion : String
		-tecnicoAsignado : Tecnico
		-unidadAsignada : UnidadServicio
		-timestamp : long
		-fechaCierre : String
		+SolicitudServicio(String id, Cliente cliente, TipoServicio tipoServicio, TipoIncidente tipoIncidente, String descripcion, String ubicacion, int prioridad)
