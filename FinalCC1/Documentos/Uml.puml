		+getZona() : String
		+setZona(String zona) : void
		+toString() : String
	}

	class UnidadServicio {
		-uuid : String
		-tipo : TipoUnidad
		-estado : EstadoUnidad
		-zona : String
		-placa : String
		+UnidadServicio(String uuid, TipoUnidad tipo, String zona, String placa)
		+estaDisponible() : boolean
		+getUuid() : String
		+getTipo() : TipoUnidad
		+getEstado() : EstadoUnidad
